{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "database.rules.json",
      "storage.rules",
      "addr_review.html",
      "app-preview.html",
      "column-3-weekend.html",
      "column-3-night.html",
      "column-6-memo-rules.html",
      "column-7-destination-origin.html",
      "report-editor-data.js",
      "drafts/**",
      "geo_check.html",
      "geo_check2.html",
      "handle-preview.html",
      "monitor.html",
      "popup-preview.html",
      "qp-audit-27.html",
      "qp-compass.html",
      "qp-diagnosis.html",
      "qp-popup.html",
      "qp-radar.html",
      "qp-toast-compare.html",
      "qp-toast-totalcall.html",
      "qp-toast.html",
      "v29-insung.html"
    ],
    "headers": [
      { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" } ] },
      { "source": "**", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" } ] },
      { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
      { "source": "**/*.apk", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "database": {
    "rules": "database.rules.json",
    "predeploy": [
      "node scripts/check-database-rules-safety.js"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
