{
  "hosting": {
    "site": "quickpilot-report-editor",
    "public": "report-editor-hosting",
    "redirects": [
      {
        "source": "/",
        "destination": "/report-editor.html",
        "type": 302
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      }
    ]
  }
}
